# Optional runtime paths. Leave empty to use platform defaults.
COUNCIL_DATA_DIR=
COUNCIL_LOG_DIR=

# Provider credentials stay in the process environment, never in Council's database.
COUNCIL_OPENAI_API_KEY=
DEEPSEEK_API_KEY=
ZHIPU_API_KEY=
MOONSHOT_API_KEY=
SILICONFLOW_API_KEY=
COUNCIL_CUSTOM_API_KEY=
# Server-only token shared by the Council launcher, FastAPI, and Next.js.
# Normal users should not set this manually; desktop launchers rotate it locally.
COUNCIL_INTERNAL_API_TOKEN=
# Only for an explicitly customized Next.js server port; defaults to 3000.
COUNCIL_FRONTEND_PORT=

# Optional server-side high-risk reviewers. Use long unique secrets and never commit real values.
# Format: reviewer-id:secret,second-reviewer-id:secret
# Evidence/professional review and final approval must use authorized reviewers; the professional
# reviewer and final approver must be different identities.
COUNCIL_HIGH_RISK_REVIEWERS=
